    {
      "name": "db7d790e",
      "displayName": "peliculas_detalle",
      "queryLines": [
        "-- peliculas_detalle: alimenta indicadores, idiomas, duración y dispersión\n",
        "SELECT\n",
        "  titulo,\n",
        "  genero_principal AS genero,\n",
        "  idioma,\n",
        "  decada,\n",
        "  anio_estreno,\n",
        "  categoria_duracion,\n",
        "  categoria_puntuacion,\n",
        "  puntuacion,\n",
        "  votos,\n",
        "  presupuesto_usd / 1e6 AS presupuesto_millones,\n",
        "  ingresos_usd / 1e6 AS ingresos_millones,\n",
        "  roi\n",
        "FROM\n",
        "  peliculas_prod.silver.peliculas"
      ]
    },
    {
      "name": "b29e96a5",
      "displayName": "genero_decada",
      "queryLines": [
        "-- genero_decada: mapa de calor\n",
        "SELECT\n",
        "  genero,\n",
        "  CAST(FLOOR(anio_estreno / 10) * 10 AS INT) AS decada,\n",
        "  COUNT(*) AS total_peliculas,\n",
        "  ROUND(AVG(puntuacion), 2) AS puntuacion_promedio\n",
        "FROM\n",
        "  peliculas_prod.silver.peliculas_genero\n",
        "WHERE\n",
        "  anio_estreno >= 1950\n",
        "GROUP BY\n",
        "  ALL"
      ]
    },
    {
      "name": "415b4951",
      "displayName": "roi_genero",
      "queryLines": [
        "-- roi_genero: rentabilidad típica por género (mediana, no la distorsionan los éxitos extremos)\n",
        "SELECT\n",
        "  genero_principal AS genero,\n",
        "  COUNT(*) AS peliculas,\n",
        "  ROUND(PERCENTILE_APPROX(roi, 0.5), 2) AS roi_mediano\n",
        "FROM\n",
        "  peliculas_prod.silver.peliculas\n",
        "WHERE\n",
        "  roi IS NOT NULL\n",
        "GROUP BY\n",
        "  genero_principal\n",
        "HAVING\n",
        "  COUNT(*) >= 50"
      ]
    }
  ],
